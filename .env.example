# Copy the ones you need into Replit's Secrets panel. Defaults shown.

# --- Storage ---
STORE_DRIVER=json                 # json (now) | postgres (pilot, adapter not written yet)
STORE_PERSISTENCE=file            # file (workspace) | replit-object-storage (deployments)
STORE_FILE=data/palmpay.json
STORE_OBJECT_KEY=palmpay/palmpay.json

# --- Banks ---
BANK_CONNECTOR=simulated          # simulated BML/MIB today; a real connector per bank later
SIM_BANK_FILE=data/sim-banks.json
SIM_BANK_OBJECT_KEY=palmpay/sim-banks.json
SIM_BANK_LATENCY_MS=350
# PARTNER_KEYS={"<key>":{"type":"bank","bankId":"bml"},"<key>":{"type":"terminal","merchantId":"mer_raalhu_cafe"}}

# --- Biometrics ---
BIOMETRIC_PROVIDER=hand-geometry  # the only adapter today; a vendor adapter replaces it later
MATCH_THRESHOLD=0.075             # lower = stricter. Tune with the distance shown in the scan screen
MATCH_MARGIN=0.8                  # best match must beat the runner-up by 20%
DUPLICATE_THRESHOLD=0.075         # blocks enrolling the same palm twice (defaults to MATCH_THRESHOLD)
LIVENESS_MODE=observe             # off | observe (show scores, never block) | enforce (block photos/screens)
LIVENESS_CHECKS=tremor,device,glare   # which checks run; remove one to turn it off
MIN_TREMOR=0.005                  # finger movement a live hand must reach (palm widths)
MAX_DEVICE_SCORE=0.6              # block if straight edges box the hand in on 3+ sides this strongly (0..1), like a phone border
MAX_GLARE=0.05                    # block if more than 5% of the palm is shiny near-white reflection
HAND_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task

# --- Payments ---
DEFAULT_PALM_LIMIT_LAARI=250000   # MVR 2,500 default per-payment limit (customer can change)
MAX_PALM_LIMIT_LAARI=1000000      # MVR 10,000 highest limit a customer can choose
MAX_SCAN_ATTEMPTS=3
INTENT_TTL_SECONDS=600

# --- Demo switches (turn all three off before showing this to anyone as "real") ---
DEMO_MODE=true                    # simulated scans, and demo partner keys handed to the browser
ALLOW_RESET=true                  # "Reset demo data" button
EXPOSE_MATCH_DEBUG=true           # shows match distance and tremor score on the scan screen
